# Copy to .env and fill in your values
# cp .env.example .env

# Discord webhook URL (no bot needed — create via Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# TradingView Desktop CDP port (default 9222 — set when launching TV Desktop)
# macOS launch command: open -a "TradingView" --args --remote-debugging-port=9222
TV_CDP_PORT=9222
